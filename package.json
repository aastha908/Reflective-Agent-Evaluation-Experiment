{
  "name": "reflective-agent-evaluation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && tsup server/index.ts --format esm --out-dir dist-server --external @prisma/client",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run-tests.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx server/seed-cli.ts",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "export": "tsx server/export-cli.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "jszip": "^3.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "prisma": "6.12.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "shell-quote": "^1.11.0"
  }
}
